---
import Base from "@/layouts/Base.astro";
import TuBun from "@/components/TuBun.astro";
---

<Base title="ตู้บุญ" description="ทำบุญให้น้องคนต่อไปได้อ่านฟรีเหมือนเจ้า">
  <section class="mx-auto max-w-xl px-4 pt-8">
    <h1 class="text-3xl text-naga-800">ตู้บุญ</h1>
    <div class="prose-hf mt-4">
      <p>
        เว็บฮักฝรั่งอ่านฟรีทุกอย่าง ไม่มีค่าสมาชิก ไม่มีกำแพงเก็บเงิน
        เพราะเฮาเชื่อว่าความรู้ที่ช่วยชีวิตคนได้ ไม่ควรมีป้ายราคา
      </p>
      <p>
        ถ้าเว็บนี้เคยช่วยเจ้าได้ และเจ้าพอมีกำลัง ฝากทำบุญเผื่อแผ่ไว้
        ให้น้องคนต่อไปได้อ่านฟรีเหมือนกัน — ทุกบาทช่วยให้เฮาเขียนเรื่องใหม่
        ตรวจข้อมูลให้ทันสมัย และเก็บทุกอย่างไว้ให้ฟรีต่อไป
      </p>
    </div>
    <TuBun />
  </section>
</Base>
