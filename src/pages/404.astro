---
import Base from "@/layouts/Base.astro";
---

<Base title="หลงทางแล้วเจ้า" description="ไม่เจอหน้านี้ — กลับไปหน้าแรกกันเน้อ">
  <section class="mx-auto max-w-xl px-4 py-16 text-center">
    <div class="text-7xl" aria-hidden="true">🧑‍🦱🗺️</div>
    <h1 class="mt-6 text-3xl text-naga-800">เอ่อ... พี่ฝรั่งหลงทางอีกแล้ว</h1>
    <p class="mx-auto mt-3 max-w-sm text-lg text-ink-soft">
      หน้านี้บ่มีเจ้า (404) — เหมือนแฟนที่ถามทางแต่บ่ยอมเปิดแผนที่
      กลับไปเริ่มใหม่กันดีกว่า
    </p>
    <a
      href="/"
      class="press mt-6 inline-block rounded-full bg-marigold-400 px-6 py-3 font-semibold text-naga-900 no-underline"
    >
      พากลับหน้าแรก →
    </a>
  </section>
</Base>
