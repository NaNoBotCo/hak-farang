---
import { PILLARS, ACCENT_CLASSES } from "@/data/pillars";
import LotusMark from "./motifs/LotusMark.astro";

/** Mobile-first top bar + horizontally-scrollable pillar chips. */
const path = Astro.url.pathname;
---

<header data-topbar class="sticky top-0 z-30 glass border-b border-marigold-200/50">
  <div class="mx-auto flex max-w-xl items-center gap-2 px-4 py-3">
    <a href="/" class="flex items-center gap-2 no-underline">
      <LotusMark size={26} />
      <span class="font-[var(--font-display)] text-xl font-semibold text-naga-700">
        ฮักฝรั่ง
      </span>
    </a>
    <span class="ms-auto text-xs text-ink-soft">พี่สาวที่ผ่านมาก่อน</span>
  </div>

  <nav aria-label="หมวดหลัก" class="border-t border-marigold-100/70">
    <ul class="mx-auto flex max-w-xl gap-2 overflow-x-auto px-4 py-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {
        PILLARS.map((p) => {
          const active = path.startsWith(`/${p.roman}`);
          const a = ACCENT_CLASSES[p.accent];
          return (
            <li>
              <a
                href={`/${p.roman}`}
                class={`press flex shrink-0 items-center gap-1.5 rounded-full px-3.5 py-1.5 text-[0.95rem] font-medium no-underline ring-1 ${
                  active
                    ? `${a.bg} text-white ring-transparent`
                    : `${a.chipBg} ${a.chipText} ring-transparent`
                }`}
              >
                <span aria-hidden="true">{p.emoji}</span>
                {p.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script>
  // The bar folds to its title row past the fold, leaves on scroll-down and returns
  // on 90 px of deliberate scroll-up (motdang's rule, 2026-09-28). Up and down
  // accumulate separately. The fold keeps the page's height: the chip row it drops
  // becomes margin under the bar, so nothing below moves. Scroll anchoring is off for
  // the instant of the fold: the height is read between the two steps, and Chrome
  // anchored on that half-folded layout and threw the page back to the top.
  const bar = document.querySelector<HTMLElement>("header[data-topbar]");
  if (bar) {
    const body = document.body;
    let y = window.pageYOffset, up = 0, dn = 0, ticking = false;
    const tight = (on: boolean) => {
      if (on === body.classList.contains("nav-tight")) return;
      const root = document.documentElement.style;
      root.overflowAnchor = "none";
      bar.style.marginBottom = "";
      const full = bar.offsetHeight;
      body.classList.toggle("nav-tight", on);
      if (on) bar.style.marginBottom = Math.max(0, full - bar.offsetHeight) + "px";
      void bar.offsetHeight;
      root.overflowAnchor = "";
    };
    const frame = () => {
      ticking = false;
      const n = window.pageYOffset, d = n - y;
      y = n;
      if (n < 60) { up = dn = 0; body.classList.remove("nav-away"); tight(false); return; }
      tight(true);
      if (d > 0) { dn += d; up = 0; if (dn > 14) body.classList.add("nav-away"); }
      else if (d < 0) { up -= d; dn = 0; if (up > 90) body.classList.remove("nav-away"); }
    };
    addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(frame); } }, { passive: true });
    addEventListener("resize", () => {
      if (body.classList.contains("nav-tight")) { body.classList.remove("nav-tight"); tight(true); }
    }, { passive: true });
    // a chip reached by keyboard must never be the one that is off-screen
    addEventListener("focusin", (e) => {
      if (bar.contains(e.target as Node)) { body.classList.remove("nav-away"); tight(false); }
    });
    frame();
  }
</script>
