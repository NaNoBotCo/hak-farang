---
/**
 * Quotable pull-card inside long articles — "hold to save", designed to be
 * screenshotted into group chats. A gold card with a naga corner flourish.
 */
interface Props {
  class?: string;
}
const { class: klass = "" } = Astro.props;
---

<figure class={`pullcard not-prose ${klass}`}>
  <span class="pullcard__quote" aria-hidden="true">“</span>
  <div class="pullcard__body">
    <slot />
  </div>
  <figcaption class="pullcard__mark flourish">ฮักฝรั่ง · hakfarang</figcaption>
</figure>

<style>
  .pullcard {
    position: relative;
    margin: 2rem 0;
    border-radius: var(--radius-card);
    background: linear-gradient(140deg, var(--color-marigold-100), var(--color-marigold-50));
    border: 1px solid var(--color-marigold-200);
    padding: 1.75rem 1.5rem 1.25rem;
    box-shadow: 0 10px 30px -18px rgba(196, 119, 15, 0.6);
    overflow: hidden;
  }
  .pullcard__quote {
    position: absolute;
    top: -0.4rem;
    left: 0.8rem;
    font-family: var(--font-display);
    font-size: 4.5rem;
    line-height: 1;
    color: var(--color-marigold-300);
  }
  .pullcard__body {
    position: relative;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.3rem;
    line-height: 1.5;
    color: var(--color-naga-800);
  }
  .pullcard__mark {
    margin-top: 1rem;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: var(--color-marigold-700);
  }
</style>
