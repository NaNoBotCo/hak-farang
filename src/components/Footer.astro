---
import { BLESSINGS } from "@/data/pillars";
import NagaDivider from "./motifs/NagaDivider.astro";

const year = new Date().getFullYear();
---

<footer class="mt-16 pb-28">
  <NagaDivider />
  <div class="mx-auto max-w-xl px-4 text-center">
    <div class="rounded-[var(--radius-card)] border border-marigold-100 bg-white/70 p-4 shadow-sm mb-6 text-sm">
      <span class="block text-[0.65rem] uppercase tracking-wide text-ink-soft mb-1">ผู้สนับสนุน</span>
      <a href="https://motdang.net" class="font-medium text-naga-700" rel="noopener">
        มดแดง Mot Dang — สารบัญเชียงใหม่-เชียงราย แบบสมุดหน้าเมือง
      </a>
      <a href="mailto:530kings@proton.me?subject=%E0%B8%A5%E0%B8%87%E0%B9%82%E0%B8%86%E0%B8%A9%E0%B8%93%E0%B8%B2%20hakfarang.net" class="ml-2 text-xs text-ink-soft underline decoration-dotted">
        ลงโฆษณาตรงนี้เน้อ
      </a>
    </div>
    <p
      class="flourish text-base text-naga-700"
      data-blessing
      data-blessings={JSON.stringify(BLESSINGS)}
    >
      {BLESSINGS[0]}
    </p>

    <nav class="mt-6 flex flex-wrap justify-center gap-x-4 gap-y-2 text-sm">
      <a href="/about" class="text-naga-600">เกี่ยวกับเฮา</a>
      <a href="/visa/visa-dependency" class="text-naga-600">สิทธิ์ของเจ้า</a>
      <a href="/tubun" class="text-naga-600">ตู้บุญ</a>
    </nav>

    <p class="mt-6 text-xs leading-relaxed text-ink-soft">
      บางลิงก์ในเว็บเป็นลิงก์แนะนำ (affiliate) — ถ้าเจ้ากดแล้วใช้บริการ
      เฮาได้ค่าน้ำใจนิดหน่อย ราคาเจ้าเท่าเดิม เนื้อหาความรู้อ่านฟรีเสมอ
    </p>
    <p class="mt-3 text-xs text-ink-soft">
      ฮักฝรั่ง · hakfarang · {year} — ทำด้วยใจ เพื่อพี่น้องเมียฝรั่งทุกคน
    </p>
    <p class="mt-2 text-[0.7rem] text-ink-soft/80">
      ข้อมูลในเว็บนี้เป็นแนวทางทั่วไป ไม่ใช่คำปรึกษากฎหมายหรือการเงินส่วนบุคคล
      เรื่องสำคัญ ๆ ควรตรวจสอบกับสถานทูตหรือผู้เชี่ยวชาญอีกครั้งเน้อ
    </p>
  </div>
</footer>

<script>
  // Rotate the blessing to a random one on load — a little daily variety.
  const el = document.querySelector<HTMLElement>("[data-blessing]");
  if (el?.dataset.blessings) {
    try {
      const list = JSON.parse(el.dataset.blessings) as string[];
      el.textContent = list[Math.floor(Math.random() * list.length)];
    } catch {
      /* keep SSR default */
    }
  }
</script>
