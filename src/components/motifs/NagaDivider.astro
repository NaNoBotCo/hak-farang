---
/**
 * Naga-scale section divider — a subtle repeating scale motif.
 * Used between major sections. Auspicious, structural, never loud.
 */
interface Props {
  color?: string;
  class?: string;
}
const { color = "var(--color-naga-300)", class: klass = "" } = Astro.props;
---

<div class={`nagadiv ${klass}`} aria-hidden="true">
  <svg viewBox="0 0 120 12" preserveAspectRatio="none" width="100%" height="12">
    <defs>
      <pattern id="naga-scale" width="24" height="12" patternUnits="userSpaceOnUse">
        <path
          d="M0 12 A12 12 0 0 1 12 0 A12 12 0 0 1 24 12"
          fill="none"
          stroke={color}
          stroke-width="1.5"
          opacity="0.55"
        />
        <path
          d="M-12 12 A12 12 0 0 1 0 0 A12 12 0 0 1 12 12"
          fill="none"
          stroke={color}
          stroke-width="1.5"
          opacity="0.35"
        />
      </pattern>
    </defs>
    <rect width="120" height="12" fill="url(#naga-scale)"></rect>
  </svg>
</div>

<style>
  .nagadiv {
    line-height: 0;
    margin-block: 1.75rem;
    opacity: 0.9;
  }
</style>
