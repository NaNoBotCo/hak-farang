---
/**
 * Lotus mark — used as a bullet glyph and as a small brand flourish.
 * Pass `size` for pixel dimensions.
 */
interface Props {
  size?: number;
  color?: string;
  class?: string;
}
const {
  size = 18,
  color = "var(--color-lotus-400)",
  class: klass = "",
} = Astro.props;
---

<svg
  class={klass}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
>
  <path
    d="M12 21c-4.2 0-7.5-2.4-7.5-2.4S6 15 8.4 14.2C6.9 12 7.2 8.7 7.2 8.7s2.7 1.3 3.6 3.4c.1-2.7 1.2-5.1 1.2-5.1s1.1 2.4 1.2 5.1c.9-2.1 3.6-3.4 3.6-3.4s.3 3.3-1.2 5.5c2.4.8 3.9 4.4 3.9 4.4S16.2 21 12 21Z"
    fill={color}
    opacity="0.9"
  />
</svg>
