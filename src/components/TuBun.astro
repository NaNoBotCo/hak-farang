---
import { TU_BUN } from "@/data/affiliates";

/**
 * ตู้บุญ — merit box. One-tap donation framed as ทำบุญให้น้องคนต่อไป:
 * "your กำลังใจ keeps the next sister's guide free." Shows a running total.
 */
const total = TU_BUN.totalTHB.toLocaleString("th-TH");
---

<section class="tubun">
  <div class="tubun__glyph flourish" aria-hidden="true"></div>
  <h2 class="tubun__title">ตู้บุญ</h2>
  <p class="tubun__lead">
    เว็บนี้ทำให้อ่านฟรี ไม่มีค่าใช้จ่าย ถ้าอันนี้ช่วยเจ้าได้
    ฝากทำบุญเผื่อแผ่ให้น้องคนต่อไป ให้เขาได้อ่านฟรีเหมือนกันเน้อ
  </p>
  <a class="tubun__cta press" href={TU_BUN.url} target="_blank" rel="noopener">
    ทำบุญให้น้องคนต่อไป 🙏
  </a>
  {
    TU_BUN.supporters > 0 && (
      <p class="tubun__count">
        มีพี่ ๆ ร่วมบุญแล้ว {TU_BUN.supporters} คน · {total} บาท — ขอบคุณเจ้า 💛
      </p>
    )
  }
</section>

<style>
  .tubun {
    margin: 2.5rem 0;
    padding: 1.75rem 1.5rem;
    text-align: center;
    border-radius: var(--radius-card);
    background: radial-gradient(120% 100% at 50% 0%, var(--color-naga-50), var(--color-cream-deep));
    border: 1px solid var(--color-naga-200);
  }
  .tubun__glyph {
    font-size: 1.5rem;
  }
  .tubun__title {
    margin: 0.25rem 0 0.5rem;
    color: var(--color-naga-700);
  }
  .tubun__lead {
    margin: 0 auto 1.1rem;
    max-width: 30rem;
    color: var(--color-ink-soft);
    font-size: 1rem;
    line-height: 1.6;
  }
  .tubun__cta {
    display: inline-block;
    background: var(--color-naga-500);
    color: #fff;
    font-weight: 600;
    padding: 0.7rem 1.4rem;
    border-radius: 9999px;
    text-decoration: none;
  }
  .tubun__count {
    margin: 0.9rem 0 0;
    font-size: 0.9rem;
    color: var(--color-naga-600);
  }
</style>
